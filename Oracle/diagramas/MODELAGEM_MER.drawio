  <diagram id="auditoria" name="Fluxo logico da auditoria - sem FK">
    <mxGraphModel dx="2100" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="audit-title" value="Auditoria transacional - fluxo de execucao" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="40" width="1400" height="60" />
        </mxCell>
        <mxCell id="indicador" value="INSERT / UPDATE / DELETE&#xa;TAB_INDICADOR_MUNICIPIO" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbe9e4;strokeColor=#315e61;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="220" width="340" height="100" />
        </mxCell>
        <mxCell id="trigger" value="TRG_INDICADOR_AUDITORIA&#xa;Valida, controla versao e grava log" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbe9e4;strokeColor=#315e61;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="220" width="340" height="100" />
        </mxCell>
        <mxCell id="log" value="TAB_AUDITORIA_INDICADOR&#xa;Codigo municipal e valores JSON" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbe9e4;strokeColor=#315e61;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="940" y="220" width="340" height="100" />
        </mxCell>
        <mxCell id="flow-0" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#315e61;" edge="1" parent="1" source="indicador" target="trigger">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="flow-1" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;strokeColor=#315e61;" edge="1" parent="1" source="trigger" target="log">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="flow-note" value="As setas nesta pagina representam execucao, nao chaves estrangeiras.&#xa;O log participa da mesma transacao: ROLLBACK tambem reverte a auditoria.&#xa;Alteracoes sem mudanca nos indicadores nao criam novo log." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="400" width="1300" height="120" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
